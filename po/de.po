#: prefs.js:22
msgid "Disabled"
msgstr "Deaktiviert"

#: prefs.js:29
msgid "Restore default"
msgstr "Standard wiederherstellen"

#: prefs.js:49
msgid "Set Shortcut"
msgstr "Tastenkürzel festlegen"

#: prefs.js:50
msgid ""
"Press the new key combination.\n"
"Esc cancels, Backspace disables the shortcut."
msgstr ""
"Drücke die neue Tastenkombination.\n"
"Esc bricht ab, Rücktaste deaktiviert das Kürzel."

#: prefs.js:52
msgid "Cancel"
msgstr "Abbrechen"

#: prefs.js:117
msgid "Anthropic API"
msgstr "Anthropic API"

#: prefs.js:118
msgid "The API key is stored in the GNOME keyring, not in dconf."
msgstr "Der API-Key wird im GNOME-Schlüsselbund gespeichert, nicht in dconf."

#: prefs.js:122
msgid "Enter API key"
msgstr "API-Key eintragen"

#: prefs.js:127
msgid "Stored API key"
msgstr "Gespeicherter API-Key"

#: prefs.js:130
msgid "Remove the API key from the keyring"
msgstr "API-Key aus dem Schlüsselbund entfernen"

#: prefs.js:138
msgid "Create an API key"
msgstr "API-Key erstellen"

#. Translators: %s are the last four characters of the API key
#: prefs.js:153
#, javascript-format
msgid "Present (ends in …%s)"
msgstr "Vorhanden (endet auf …%s)"

#: prefs.js:153
msgid "None"
msgstr "Keiner"

#: prefs.js:156
#, javascript-format
msgid "Keyring not available: %s"
msgstr "Schlüsselbund nicht erreichbar: %s"

#: prefs.js:168
msgid "API key saved"
msgstr "API-Key gespeichert"

#: prefs.js:170
#, javascript-format
msgid "Saving failed: %s"
msgstr "Speichern fehlgeschlagen: %s"

#: prefs.js:177
msgid "API key removed"
msgstr "API-Key entfernt"

#: prefs.js:179
#, javascript-format
msgid "Removing failed: %s"
msgstr "Entfernen fehlgeschlagen: %s"

#: prefs.js:190
msgid "Model"
msgstr "Modell"

#: prefs.js:191
msgid ""
"Defaults for new chats. The prompt dialog can switch the model and effort of "
"each chat."
msgstr ""
"Standard für neue Chats. Im Prompt-Dialog lassen sich Modell und Aufwand pro "
"Chat wechseln."

#: prefs.js:193
msgid "Claude model"
msgstr "Claude-Modell"

#: prefs.js:196
msgid "Effort"
msgstr "Aufwand"

#: prefs.js:197
msgid "Lower answers faster and cheaper, higher thinks more thoroughly"
msgstr ""
"Niedriger antwortet schneller und günstiger, höher denkt gründlicher nach"

#: prefs.js:203
msgid "Usage"
msgstr "Bedienung"

#: prefs.js:205
msgid "Shortcut"
msgstr "Tastenkürzel"

#: prefs.js:206
msgid "Opens and closes the prompt dialog"
msgstr "Öffnet und schließt den Prompt-Dialog"

#: prefs.js:210
msgid "Continue the last chat"
msgstr "Letzten Chat fortsetzen"

#: prefs.js:211
msgid ""
"The shortcut and the top bar icon reopen the most recent chat instead of "
"starting a new one"
msgstr ""
"Tastenkürzel und Topbar-Symbol öffnen den letzten Chat, statt einen neuen zu "
"beginnen"

#: prefs.js:217
msgid "Chats in the history"
msgstr "Chats im Verlauf"

