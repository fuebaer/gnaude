#: prefs.js:22
msgid "Disabled"
msgstr "Desactivado"

#: prefs.js:29
msgid "Restore default"
msgstr "Restablecer el valor predeterminado"

#: prefs.js:49
msgid "Set Shortcut"
msgstr "Establecer atajo"

#: prefs.js:50
msgid ""
"Press the new key combination.\n"
"Esc cancels, Backspace disables the shortcut."
msgstr ""
"Pulsa la nueva combinación de teclas.\n"
"Esc cancela, Retroceso desactiva el atajo."

#: prefs.js:52
msgid "Cancel"
msgstr "Cancelar"

#: prefs.js:117
msgid "Anthropic API"
msgstr "API de Anthropic"

#: prefs.js:118
msgid "The API key is stored in the GNOME keyring, not in dconf."
msgstr ""
"La clave de API se guarda en el depósito de claves de GNOME, no en dconf."

#: prefs.js:122
msgid "Enter API key"
msgstr "Introducir la clave de API"

#: prefs.js:127
msgid "Stored API key"
msgstr "Clave de API almacenada"

#: prefs.js:130
msgid "Remove the API key from the keyring"
msgstr "Quitar la clave de API del depósito de claves"

#: prefs.js:138
msgid "Create an API key"
msgstr "Crear una clave de API"

#. Translators: %s are the last four characters of the API key
#: prefs.js:153
#, javascript-format
msgid "Present (ends in …%s)"
msgstr "Presente (termina en …%s)"

#: prefs.js:153
msgid "None"
msgstr "Ninguna"

#: prefs.js:156
#, javascript-format
msgid "Keyring not available: %s"
msgstr "Depósito de claves no disponible: %s"

#: prefs.js:168
msgid "API key saved"
msgstr "Clave de API guardada"

#: prefs.js:170
#, javascript-format
msgid "Saving failed: %s"
msgstr "Error al guardar: %s"

#: prefs.js:177
msgid "API key removed"
msgstr "Clave de API eliminada"

#: prefs.js:179
#, javascript-format
msgid "Removing failed: %s"
msgstr "Error al eliminar: %s"

#: prefs.js:190
msgid "Model"
msgstr "Modelo"

#: prefs.js:191
msgid ""
"Defaults for new chats. The prompt dialog can switch the model and effort of "
"each chat."
msgstr ""
"Valores predeterminados para los chats nuevos. En el diálogo de consulta se "
"pueden cambiar el modelo y el esfuerzo de cada chat."

#: prefs.js:193
msgid "Claude model"
msgstr "Modelo de Claude"

#: prefs.js:196
msgid "Effort"
msgstr "Esfuerzo"

#: prefs.js:197
msgid "Lower answers faster and cheaper, higher thinks more thoroughly"
msgstr ""
"Más bajo responde más rápido y barato, más alto piensa con más detenimiento"

#: prefs.js:203
msgid "Usage"
msgstr "Uso"

#: prefs.js:205
msgid "Shortcut"
msgstr "Atajo de teclado"

#: prefs.js:206
msgid "Opens and closes the prompt dialog"
msgstr "Abre y cierra el diálogo de consulta"

#: prefs.js:210
msgid "Continue the last chat"
msgstr "Continuar el último chat"

#: prefs.js:211
msgid ""
"The shortcut and the top bar icon reopen the most recent chat instead of "
"starting a new one"
msgstr ""
"El atajo y el icono de la barra superior vuelven a abrir el chat más "
"reciente en lugar de empezar uno nuevo"

#: prefs.js:217
msgid "Chats in the history"
msgstr "Chats en el historial"

#. Translators: number of questions asked in a chat, shown in the history menu
#: lib/indicator.js:61
#, javascript-format
msgid "%d question"
msgid_plural "%d questions"
msgstr[0] "%d pregunta"
msgstr[1] "%d preguntas"

#: lib/indicator.js:73 lib/promptDialog.js:302
msgid "Stop"
msgstr "Detener"

#: lib/indicator.js:130
msgid "New chat …"
msgstr "Chat nuevo…"

#: lib/indicator.js:132
msgid "History"
msgstr "Historial"

#: lib/indicator.js:134
msgid "No chats yet"
msgstr "Aún no hay chats"

#: lib/indicator.js:151
msgid "Clear history"
msgstr "Borrar historial"

#: lib/indicator.js:153
msgid "Settings"
msgstr "Configuración"

#: lib/messages.js:16
msgid "thinking …"
msgstr "pensando…"

#: lib/messages.js:18
msgid "writing …"
msgstr "escribiendo…"

#: lib/messages.js:20
msgid "fallback model takes over …"
msgstr "el modelo de respaldo toma el relevo…"

#: lib/messages.js:22
msgid "connecting …"
msgstr "conectando…"

#: lib/messages.js:29
msgid "done"
msgstr "terminado"

#: lib/messages.js:31
msgid "declined"
msgstr "rechazado"

#: lib/messages.js:33
msgid "cancelled"
msgstr "cancelado"

#: lib/messages.js:35
msgid "error"
msgstr "error"

#: lib/messages.js:53
