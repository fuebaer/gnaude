msgstr "modelo de respaldo"

#: lib/messages.js:55
msgid "cut off (maximum length)"
msgstr "cortado (longitud máxima)"

#: lib/messages.js:71
msgid "No API key set. Add one in the Gnaude preferences."
msgstr "No hay ninguna clave de API. Añade una en las preferencias de Gnaude."

#: lib/messages.js:73
msgid "Interrupted (the extension was reloaded)."
msgstr "Interrumpido (la extensión se ha recargado)."

#: lib/messages.js:75
msgid "Cancelled."
msgstr "Cancelado."

#: lib/messages.js:77
msgid "The connection closed before the answer was complete."
msgstr "La conexión se cerró antes de que la respuesta estuviera completa."

#. Translators: %s is a refusal category reported by the API, e.g. "cyber"
#: lib/messages.js:81
#, javascript-format
msgid "Claude declined this request (category: %s)."
msgstr "Claude ha rechazado esta solicitud (categoría: %s)."

#: lib/messages.js:82
msgid "Claude declined this request."
msgstr "Claude ha rechazado esta solicitud."

#: lib/messages.js:103
msgid "Writing the answer …"
msgstr "Escribiendo la respuesta…"

#: lib/messages.js:105
msgid "(empty answer)"
msgstr "(respuesta vacía)"

#: lib/models.js:18
msgid "Low (fastest)"
msgstr "Bajo (el más rápido)"

#: lib/models.js:18
msgid "Low"
msgstr "Bajo"

#: lib/models.js:19
msgid "Medium"
msgstr "Medio"

#: lib/models.js:20
msgid "High"
msgstr "Alto"

#: lib/models.js:21
msgid "Very high"
msgstr "Muy alto"

#: lib/models.js:22
msgid "Maximum"
msgstr "Máximo"

#: lib/promptDialog.js:86
msgid ""
"Enter: send  ·  Shift+Enter: new line  ·  Ctrl+M: model  ·  Ctrl+E: effort  "
"·  Ctrl+N: new chat  ·  Esc: close"
msgstr ""
"Intro: enviar  ·  Mayús+Intro: nueva línea  ·  Ctrl+M: modelo  ·  Ctrl+E: "
"esfuerzo  ·  Ctrl+N: chat nuevo  ·  Esc: cerrar"

#: lib/promptDialog.js:246
msgid "Choose model"
msgstr "Elegir modelo"

#: lib/promptDialog.js:258
msgid "Choose effort"
msgstr "Elegir esfuerzo"

#: lib/promptDialog.js:303 lib/promptDialog.js:539
msgid "Copy"
msgstr "Copiar"

#: lib/promptDialog.js:304
msgid "New chat"
msgstr "Chat nuevo"

