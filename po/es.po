#: lib/promptDialog.js:430
#, javascript-format
msgid "Default (%s)"
msgstr "Predeterminado (%s)"

#: lib/promptDialog.js:449
msgid "Ask a follow-up question …"
msgstr "Haz una pregunta de seguimiento…"

#: lib/promptDialog.js:449
