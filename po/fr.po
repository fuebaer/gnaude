msgid "thinking …"
msgstr "réfléchit…"

#: lib/messages.js:18
msgid "writing …"
msgstr "écrit…"

#: lib/messages.js:20
msgid "fallback model takes over …"
msgstr "le modèle de repli prend le relais…"

#: lib/messages.js:22
msgid "connecting …"
msgstr "connexion…"

#: lib/messages.js:29
msgid "done"
msgstr "terminé"

#: lib/messages.js:31
msgid "declined"
msgstr "refusé"

#: lib/messages.js:33
msgid "cancelled"
msgstr "annulé"

#: lib/messages.js:35
msgid "error"
msgstr "erreur"

#: lib/messages.js:53
