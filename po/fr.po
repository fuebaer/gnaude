#: lib/messages.js:81
#, javascript-format
msgid "Claude declined this request (category: %s)."
msgstr "Claude a refusé cette demande (catégorie : %s)."

#: lib/messages.js:82
msgid "Claude declined this request."
msgstr "Claude a refusé cette demande."

#: lib/messages.js:103
msgid "Writing the answer …"
msgstr "Rédaction de la réponse…"

#: lib/messages.js:105
msgid "(empty answer)"
msgstr "(réponse vide)"

#: lib/models.js:18
msgid "Low (fastest)"
msgstr "Bas (le plus rapide)"

#: lib/models.js:18
msgid "Low"
msgstr "Bas"

#: lib/models.js:19
msgid "Medium"
msgstr "Moyen"

#: lib/models.js:20
msgid "High"
msgstr "Élevé"

#: lib/models.js:21
msgid "Very high"
msgstr "Très élevé"

#: lib/models.js:22
msgid "Maximum"
msgstr "Maximal"

#: lib/promptDialog.js:86
msgid ""
"Enter: send  ·  Shift+Enter: new line  ·  Ctrl+M: model  ·  Ctrl+E: effort  "
"·  Ctrl+N: new chat  ·  Esc: close"
msgstr ""
"Entrée : envoyer  ·  Maj+Entrée : nouvelle ligne  ·  Ctrl+M : modèle  ·  "
"Ctrl+E : effort  ·  Ctrl+N : nouvelle discussion  ·  Échap : fermer"

#: lib/promptDialog.js:246
msgid "Choose model"
msgstr "Choisir le modèle"

#: lib/promptDialog.js:258
msgid "Choose effort"
msgstr "Choisir l’effort"

