#: lib/messages.js:55
msgid "cut off (maximum length)"
msgstr "tronqué (longueur maximale)"

#: lib/messages.js:71
msgid "No API key set. Add one in the Gnaude preferences."
msgstr "Aucune clé API définie. Ajoutez-en une dans les préférences de Gnaude."

#: lib/messages.js:73
msgid "Interrupted (the extension was reloaded)."
msgstr "Interrompu (l’extension a été rechargée)."

#: lib/messages.js:75
msgid "Cancelled."
msgstr "Annulé."

#: lib/messages.js:77
msgid "The connection closed before the answer was complete."
msgstr "La connexion a été fermée avant la fin de la réponse."

