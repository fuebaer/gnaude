#: prefs.js:22
msgid "Disabled"
msgstr "Désactivé"

#: prefs.js:29
msgid "Restore default"
msgstr "Rétablir la valeur par défaut"

#: prefs.js:49
msgid "Set Shortcut"
msgstr "Définir le raccourci"

#: prefs.js:50
msgid ""
"Press the new key combination.\n"
"Esc cancels, Backspace disables the shortcut."
msgstr ""
"Appuyez sur la nouvelle combinaison de touches.\n"
"Échap annule, Retour arrière désactive le raccourci."

#: prefs.js:52
msgid "Cancel"
msgstr "Annuler"

#: prefs.js:117
msgid "Anthropic API"
msgstr "API Anthropic"

#: prefs.js:118
msgid "The API key is stored in the GNOME keyring, not in dconf."
msgstr "La clé API est enregistrée dans le trousseau GNOME, pas dans dconf."

#: prefs.js:122
msgid "Enter API key"
msgstr "Saisir la clé API"

#: prefs.js:127
msgid "Stored API key"
msgstr "Clé API stockée"

#: prefs.js:130
msgid "Remove the API key from the keyring"
msgstr "Supprimer la clé API du trousseau"

#: prefs.js:138
msgid "Create an API key"
msgstr "Créer une clé API"

#. Translators: %s are the last four characters of the API key
#: prefs.js:153
#, javascript-format
msgid "Present (ends in …%s)"
msgstr "Présente (se termine par …%s)"

#: prefs.js:153
msgid "None"
msgstr "Aucune"

#: prefs.js:156
#, javascript-format
msgid "Keyring not available: %s"
msgstr "Trousseau indisponible : %s"

#: prefs.js:168
msgid "API key saved"
msgstr "Clé API enregistrée"

#: prefs.js:170
#, javascript-format
msgid "Saving failed: %s"
msgstr "Échec de l’enregistrement : %s"

#: prefs.js:177
msgid "API key removed"
msgstr "Clé API supprimée"

#: prefs.js:179
#, javascript-format
msgid "Removing failed: %s"
msgstr "Échec de la suppression : %s"

#: prefs.js:190
msgid "Model"
msgstr "Modèle"

#: prefs.js:191
msgid ""
"Defaults for new chats. The prompt dialog can switch the model and effort of "
"each chat."
msgstr ""
"Valeurs par défaut des nouvelles discussions. La fenêtre de saisie permet de "
"changer le modèle et l’effort de chaque discussion."

#: prefs.js:193
msgid "Claude model"
msgstr "Modèle Claude"

#: prefs.js:196
msgid "Effort"
msgstr "Effort"

#: prefs.js:197
msgid "Lower answers faster and cheaper, higher thinks more thoroughly"
msgstr ""
"Plus bas répond plus vite et moins cher, plus haut réfléchit plus en "
"profondeur"

#: prefs.js:203
msgid "Usage"
msgstr "Utilisation"

#: prefs.js:205
msgid "Shortcut"
msgstr "Raccourci"

#: prefs.js:206
msgid "Opens and closes the prompt dialog"
msgstr "Ouvre et ferme la fenêtre de saisie"

#: prefs.js:210
msgid "Continue the last chat"
msgstr "Reprendre la dernière discussion"

#: prefs.js:211
msgid ""
"The shortcut and the top bar icon reopen the most recent chat instead of "
"starting a new one"
msgstr ""
"Le raccourci et l’icône de la barre supérieure rouvrent la discussion la "
"plus récente au lieu d’en commencer une nouvelle"

#: prefs.js:217
msgid "Chats in the history"
msgstr "Discussions dans l’historique"

#. Translators: number of questions asked in a chat, shown in the history menu
#: lib/indicator.js:61
#, javascript-format
msgid "%d question"
msgid_plural "%d questions"
msgstr[0] "%d question"
msgstr[1] "%d questions"

#: lib/indicator.js:73 lib/promptDialog.js:302
msgid "Stop"
msgstr "Arrêter"

#: lib/indicator.js:130
msgid "New chat …"
msgstr "Nouvelle discussion…"

#: lib/indicator.js:132
msgid "History"
msgstr "Historique"

#: lib/indicator.js:134
msgid "No chats yet"
msgstr "Aucune discussion pour l’instant"

#: lib/indicator.js:151
msgid "Clear history"
msgstr "Effacer l’historique"

#: lib/indicator.js:153
msgid "Settings"
msgstr "Paramètres"

